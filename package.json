{
  "name": "kindraapi",
  "productName": "KindraAPI",
  "version": "0.2.3",
  "description": "KindraAPI — local-first API client with request history, flow automation and MCP",
  "main": "./out/main/index.js",
  "author": "KindraAPI",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke:bundle": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --external:electron --external:postman-runtime --external:postman-collection --external:mqtt --external:aedes --alias:@shared=./src/shared --outfile=scripts/.smoke.cjs",
    "smoke": "npm run smoke:bundle && electron scripts/.smoke.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "mcp": "node mcp-stdio.cjs",
    "demo": "node scripts/demo-server.cjs",
    "pack:mac": "npm run build && electron-builder --mac dmg zip",
    "pack:win": "npm run build && electron-builder --win nsis zip --x64"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "antd": "^5.29.3",
    "mqtt": "^5.16.1",
    "mysql2": "^3.24.6",
    "postman-collection": "^5.3.1",
    "postman-runtime": "^7.56.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "aedes": "^0.51.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
