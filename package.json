{
  "name": "kindraapi",
  "productName": "KindraAPI",
  "version": "0.2.6",
  "description": "KindraAPI \u2014 local-first API client with request history, flow automation and MCP",
  "main": "./out/main/index.js",
  "author": "KindraAPI",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:flow-entry": "esbuild scripts/flow-entry-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/flow-entry-smoke.cjs && electron node_modules/.tmp/flow-entry-smoke.cjs",
    "test:documentation": "esbuild scripts/documentation-smoke.ts --bundle --platform=node --format=cjs --external:electron --external:postman-runtime --external:postman-collection --external:mqtt --external:aedes --alias:@shared=./src/shared --outfile=scripts/.documentation-smoke.cjs && electron scripts/.documentation-smoke.cjs",
    "test:client-sync": "esbuild scripts/client-sync-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/client-sync-smoke.cjs && electron node_modules/.tmp/client-sync-smoke.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke:bundle": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --external:electron --external:postman-runtime --external:postman-collection --external:mqtt --external:aedes --alias:@shared=./src/shared --outfile=scripts/.smoke.cjs",
    "smoke": "npm run smoke:bundle && electron scripts/.smoke.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "ui:inventory": "node ui-inventory/tools/static-scan.mjs && node ui-inventory/tools/capture.mjs && node ui-inventory/tools/compact-inventory.mjs && node ui-inventory/tools/generate-docs.mjs",
    "ui:inventory:docs": "node ui-inventory/tools/static-scan.mjs && node ui-inventory/tools/compact-inventory.mjs && node ui-inventory/tools/generate-docs.mjs",
    "ui:inventory:capture": "node ui-inventory/tools/capture.mjs",
    "ui:inventory:compact": "node ui-inventory/tools/compact-inventory.mjs",
    "mcp": "node mcp-stdio.cjs",
    "demo": "node scripts/demo-server.cjs",
    "pack:mac": "npm run build && electron-builder --mac dmg zip",
    "pack:win": "npm run build && electron-builder --win nsis zip --x64",
    "test:debug-runtime": "esbuild scripts/debug-runtime-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/debug-runtime-smoke.cjs && electron node_modules/.tmp/debug-runtime-smoke.cjs",
    "test:debug-ui": "node scripts/debug-ui-smoke.cjs",
    "test:debug-parity": "node scripts/debug-parity-smoke.cjs",
    "test:parameter-inputs": "node scripts/dictionary-input-smoke.cjs",
    "test:dictionary-ui": "node scripts/dictionary-module-smoke.cjs",
    "test:review-regressions": "node scripts/review-regressions.cjs",
    "test:model-actions": "node scripts/model-editor-actions-smoke.cjs",
    "test:dictionary-data": "esbuild scripts/dictionary-import-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/dictionary-import-smoke.cjs && electron node_modules/.tmp/dictionary-import-smoke.cjs",
    "test:flow-snapshot": "esbuild scripts/flow-snapshot-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/flow-snapshot-smoke.cjs && electron node_modules/.tmp/flow-snapshot-smoke.cjs",
    "test:flow-async": "esbuild scripts/flow-async-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/flow-async-smoke.cjs && electron node_modules/.tmp/flow-async-smoke.cjs",
    "test:flow-definitions": "esbuild scripts/flow-definition-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/flow-definition-smoke.cjs && electron node_modules/.tmp/flow-definition-smoke.cjs",
    "test:flow-dependencies": "esbuild scripts/flow-dependency-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/flow-dependency-smoke.cjs && electron node_modules/.tmp/flow-dependency-smoke.cjs",
    "test:flow-pause": "esbuild scripts/flow-pause-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/flow-pause-smoke.cjs && electron node_modules/.tmp/flow-pause-smoke.cjs",
    "test:flow-progress": "esbuild scripts/flow-progress-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=scripts/.flow-progress-smoke.cjs && electron scripts/.flow-progress-smoke.cjs",
    "test:flow-progress-ui": "node scripts/flow-progress-ui.cjs",
    "test:flow-cancel": "esbuild scripts/flow-cancel-smoke.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./src/shared --outfile=node_modules/.tmp/flow-cancel-smoke.cjs && electron node_modules/.tmp/flow-cancel-smoke.cjs",
    "test:flow-cancel-ui": "node scripts/flow-cancel-ui.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "antd": "^5.29.3",
    "mqtt": "^5.16.1",
    "mysql2": "^3.24.6",
    "postman-collection": "^5.3.1",
    "postman-runtime": "^7.56.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "aedes": "^0.51.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
